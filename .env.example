# Task 4 - Concurrency / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=transacciones-group
KAFKA_TOPIC_INPUT=transacciones-entrada
KAFKA_TOPIC_OUTPUT=transacciones-resultados
EXECUTOR_CORE_POOL_SIZE=4
EXECUTOR_MAX_POOL_SIZE=8
EXECUTOR_QUEUE_CAPACITY=100

# Proyecto final
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=banco_core
