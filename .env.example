# Common
APP_NAME=ProgramacionAvanzadaJava
APP_PROFILE=dev

# Task 3 - API REST bancaria
SERVER_PORT=8080
DB_URL=jdbc:h2:mem:bancodb;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=
JWT_SECRET=change-this-secret-in-production
